# Copy this file to .env and fill in your keys. Never commit .env.

# Google Places API (New). Without it the tool uses OpenStreetMap only.
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights API. Optional: if empty, GOOGLE_PLACES_API_KEY is used
# (enable "PageSpeed Insights API" on the same Google Cloud project).
PAGESPEED_API_KEY=
