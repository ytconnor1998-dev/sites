# Copy this file to .env for running on your own computer. Never commit .env.
# (Online, these go in the Streamlit Cloud app's Secrets instead.)

# Password for the dashboard.
APP_PASSWORD=

# Google Places API (New). Without it the tool uses OpenStreetMap only.
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights API. Optional: if empty, GOOGLE_PLACES_API_KEY is used
# (enable "PageSpeed Insights API" on the same Google Cloud project).
PAGESPEED_API_KEY=

# Optional: the online database. Set it to share leads between this computer
# and the online dashboard. Leave empty to use a local file (data/leads.db).
DATABASE_URL=
