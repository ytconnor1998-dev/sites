{
  "name": "loose-change",
  "productName": "Loose Change",
  "version": "0.1.0",
  "description": "An incremental game about checking down the back of the sofa.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "assets": "node tools/copy-assets.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "balance": "node tools/balance.js",
    "icon": "node tools/make-icon.js"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@twemoji/svg": "15.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "three": "0.186.1"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "com.loosechange.game",
    "productName": "Loose Change",
    "copyright": "Loose Change",
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "steam_appid.txt",
        "to": "steam_appid.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Game"
    }
  }
}
