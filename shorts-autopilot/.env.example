# ── Required ────────────────────────────────────────────────────────────
# The password you type to log in to the site.
APP_PASSWORD=change-me
# Long random string. Signs your login cookie and encrypts your YouTube/TikTok tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# The public address of the site, no trailing slash. OAuth redirects come back here.
PUBLIC_URL=http://localhost:3000

# ── AI (Claude) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── YouTube (Google Cloud → APIs & Services → Credentials → OAuth client, "Web application") ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── TikTok (developers.tiktok.com → your app → Login Kit + Content Posting API) ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=./data
